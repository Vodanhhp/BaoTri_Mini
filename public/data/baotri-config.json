  "idRules": {
    "common": {
      "uniqueScope": "organization",
      "immutableAfterAssignment": true,
      "neverReuseAssignedIds": true,
      "preserveExistingIdsOnPlanChange": true,
      "sequenceMustExpandBeyondThreeDigits": true,
      "aiMaySuggestButMustNotAllocateOfficialSequence": true
    },
    "PLAN_A": {
      "pattern": "{EQUIPMENT_CODE}-{SEQUENCE}",
      "equipmentCodeLength": { "min": 2, "max": 4 },
      "sequence": { "start": 1, "minWidth": 3, "maxDevices": 200 },
      "includesGroupCode": false,
      "includesSiteCode": false,
      "includesCommissionMonthYear": false
    },
    "PLAN_B": {
      "pattern": "{EQUIPMENT_CODE}-{GROUP_CODE}-{SEQUENCE}",
      "equipmentCodeLength": { "min": 2, "max": 4 },
      "sequence": { "start": 1, "minWidth": 3, "maxDevices": 500 },
      "includesGroupCode": true,
      "includesSiteCode": false,
      "includesCommissionMonthYear": false
    },
    "PLAN_C": {
      "pattern": "{EQUIPMENT_CODE}-{GROUP_CODE}-{SITE_CODE}-{SEQUENCE}-{MMYY}",
      "equipmentCodeLength": { "min": 2, "max": 4 },
      "siteCode": { "default": "00", "format": "two-digit-sequence" },
      "sequence": { "start": 1, "minWidth": 3, "scope": "organization+equipmentCode+groupCode+siteCode", "expandable": true },
      "commissionMonthYear": { "format": "MMYY", "source": "confirmedCommissioningDate" },
      "includesGroupCode": true,
      "includesSiteCode": true,
      "includesCommissionMonthYear": true
    },
    "PLAN_D": {
      "pattern": "{EQUIPMENT_CODE}-{GROUP_CODE}-{SITE_CODE}-{SEQUENCE}-{MMYY}",
      "equipmentCodeLength": { "min": 2, "max": 4 },
      "siteCode": { "default": "00", "format": "two-digit-sequence" },
      "sequence": { "start": 1, "minWidth": 3, "scope": "organization+equipmentCode+groupCode+siteCode", "expandable": true },
      "commissionMonthYear": { "format": "MMYY", "source": "confirmedCommissioningDate" },
      "includesGroupCode": true,
      "includesSiteCode": true,
      "includesCommissionMonthYear": true
    }
  },
  "notes": [
    "Ngành nghề chỉ cung cấp ngữ cảnh và gợi ý, không giới hạn loại thiết bị doanh nghiệp được phép khai báo.",
    "Plan A không hiển thị chức năng nhóm thiết bị; Engine vẫn có thể dùng phân loại nội bộ để hỗ trợ nhận diện.",
    "Các mã nhóm và mã thiết bị là hai lớp khác nhau. Ví dụ BOM là mã loại máy bơm, NUO là mã nhóm cấp thoát nước.",
    "Danh mục hiện là dữ liệu khởi tạo theo phương án đã duyệt; có thể mở rộng bằng cách tăng dataVersion và giữ nguyên schemaVersion.",
    "Tệp này chỉ cung cấp cấu hình dữ liệu. Ứng dụng cần được tích hợp bộ đọc và kiểm tra dữ liệu riêng trước khi sử dụng trong nghiệp vụ."
